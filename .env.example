# JobPingly configuration.
#
# Copy to .env.local for local development. On a host (Render, a VPS, ...)
# set these as environment variables instead. Never commit real values.
# Only DATABASE_URL and APP_SECRET are required in production; everything
# else has a safe default or switches a feature off when missing.

# --- Required ---------------------------------------------------------------

# PostgreSQL. For Supabase use the transaction pooler (port 6543) here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobpingly"

# Optional: a direct or session-mode connection (port 5432) used only for
# migrations, which need a real session. Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=""

# Random string of at least 32 characters, used to sign unsubscribe links and
# similar tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Existing v1 deployments may keep using JWT_ACCESS_SECRET instead.
APP_SECRET=""

# Public address of the site, used in emails and links. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Accounts -----------------------------------------------------------------

# The account with this address always has the owner role (applied when it
# signs in), and its alert emails are approved automatically.
ADMIN_BOOTSTRAP_EMAIL=""

# Google sign-in (optional). Create an OAuth client ID of type "Web
# application" and add your site to its authorised JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# --- Email --------------------------------------------------------------------

# "brevo" sends real email; "console" logs messages instead (default when no
# BREVO_API_KEY is set). Use console for local development.
EMAIL_PROVIDER="console"
BREVO_API_KEY=""
SENDER_EMAIL="notifications@example.com"
SENDER_NAME="JobPingly"
# Brevo's free plan allows 300 emails a day; keep a buffer for sign-in codes.
BREVO_DAILY_LIMIT="300"
BREVO_SAFETY_BUFFER="50"
# Shared secret Brevo must send with delivery webhooks (bounces, complaints).
# The webhook endpoint rejects every request while this is empty.
BREVO_WEBHOOK_SECRET=""

# --- Background worker --------------------------------------------------------

# separate: npm start runs the web server and the worker as two processes
# inline:   the worker runs inside the web server (saves memory)
# off:      web server only; drive the worker with "npm run worker:once" or
#           POST /api/cron/tick from an external scheduler
WORKER_MODE="separate"
WORKER_ID="default"
WORKER_POLL_INTERVAL_MS="60000"
WORKER_CONCURRENCY="4"
WORKER_BATCH_SIZE="20"

# Secret for POST /api/cron/tick (at least 16 characters). Disabled when empty.
CRON_SECRET=""

# Set to "true" to skip the automatic migration step in npm start.
SKIP_MIGRATIONS=""

# --- Optional services ----------------------------------------------------------

# AI-assisted extraction for career pages no adapter understands. Any one
# provider is enough; leave all empty to disable.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OLLAMA_API_KEY=""
OLLAMA_MODEL=""
OLLAMA_BASE_URL=""

# Shared rate limits across several server instances (Upstash Redis REST).
# Without it, limits are kept per process, which is fine for one instance.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Networking -----------------------------------------------------------------

# Header holding the real client IP when behind a proxy that sets it
# (Render/Cloudflare: cf-connecting-ip). Otherwise X-Forwarded-For is used.
CLIENT_IP_HEADER=""
TRUSTED_PROXY_HOPS="1"
DB_POOL_MAX=""

# --- Local development only -------------------------------------------------------

# Password for the account created by "npm run seed:demo".
SEED_DEMO_PASSWORD=""
